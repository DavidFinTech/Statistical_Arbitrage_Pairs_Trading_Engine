    "def clean_line(line):\n",
    "    values = line.split()\n",
    "    closing_price = values[1]\n",
    "    clean_closing_price = closing_price.replace('$','').strip()\n",
    "    return  float(clean_closing_price)\n",
    "line = \"7/11/2025\\t$313.51\\t79236440\"\n",
    "print(clean_line(line))\n",
